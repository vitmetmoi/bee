1n gi\u1ea3n mu\u1ed1n c\u00f3 h\u01b0\u1edbng d\u1eabn chu\u1ea9n. \\n\n          \\n\n          M\u00ecnh th\u1ea5y c\u00e2u h\u1ecfi l\u1eb7p l\u1ea1i 2 l\u1ea7n \"L\u00e0m sao \u0111\u1ec3 n\u1ea5u m\u00ec t\u00f4m\" ch\u1ee9ng t\u1ecf h\u1ecd th\u1ef1c s\u1ef1 mu\u1ed1n nh\u1ea5n m\u1ea1nh. C\u00f3 l\u1ebd h\u1ecd c\u1ea7n c\u00f4ng th\u1ee9c \u0111\u01a1n gi\u1ea3n nh\u1ea5t, kh\u00f4ng c\u1ea7u k\u1ef3. \\n\n          \\n\n          M\u00ecnh s\u1ebd chia l\u00e0m 2 phi\u00ean b\u1ea3n: c\u01a1 b\u1ea3n (ch\u1ec9 d\u00f9ng g\u00f3i gia v\u1ecb) v\u00e0 n\u00e2ng c\u1ea5p (th\u00eam rau\/tr\u1ee9ng). C\u1ea7n nh\u1eafc h\u1ecd kh\u00f4ng \u0111\u1ed5 n\u01b0\u1edbc s\u00f4i tr\u1ef1c ti\u1ebfp v\u00e0o t\u00f4 nh\u1ef1a v\u00ec an to\u00e0n s\u1ee9c kh\u1ecfe - chi ti\u1ebft n\u00e0y nhi\u1ec1u ng\u01b0\u1eddi b\u1ecf qua. \\n\n          \\n\n          \u00c0, ph\u1ea3i ghi r\u00f5 th\u1eddi gian ch\u1edd 3 ph\u00fat v\u00ec nhi\u1ec1u ng\u01b0\u1eddi n\u00f3ng v\u1ed9i \u0103n m\u00ec c\u00f2n s\u1ed1ng. V\u00e0 nh\u1edb khuy\u00ean \"kh\u00f4ng n\u00ean\n          \"\"\"\n        \"content_html\" => \"\"\"\n          <p>\u1ed2, ng\u01b0\u1eddi d\u00f9ng h\u1ecfi c\u00e1ch n\u1ea5u m\u00ec t\u00f4m - m\u1ed9t c\u00e2u h\u1ecfi r\u1ea5t c\u01a1 b\u1ea3n nh\u01b0ng c\u0169ng c\u1ef1c k\u1ef3 thi\u1ebft th\u1ef1c. M\u00ecnh c\u1ea7n l\u01b0u \u00fd \u0111\u00e2y c\u00f3 th\u1ec3 l\u00e0 ng\u01b0\u1eddi m\u1edbi v\u00e0o b\u1ebfp, ho\u1eb7c ch\u1ec9 \u0111\u01a1n gi\u1ea3n mu\u1ed1n c\u00f3 h\u01b0\u1edbng d\u1eabn chu\u1ea9n.<\/p>\\n\n          <p>M\u00ecnh th\u1ea5y c\u00e2u h\u1ecfi l\u1eb7p l\u1ea1i 2 l\u1ea7n &quot;L\u00e0m sao \u0111\u1ec3 n\u1ea5u m\u00ec t\u00f4m&quot; ch\u1ee9ng t\u1ecf h\u1ecd th\u1ef1c s\u1ef1 mu\u1ed1n nh\u1ea5n m\u1ea1nh. C\u00f3 l\u1ebd h\u1ecd c\u1ea7n c\u00f4ng th\u1ee9c \u0111\u01a1n gi\u1ea3n nh\u1ea5t, kh\u00f4ng c\u1ea7u k\u1ef3.<\/p>\\n\n          <p>M\u00ecnh s\u1ebd chia l\u00e0m 2 phi\u00ean b\u1ea3n: c\u01a1 b\u1ea3n (ch\